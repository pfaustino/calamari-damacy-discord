{
  "name": "calamari-damacy-discord",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-css.mjs && vite",
    "dev:server": "npm --prefix server run dev",
    "dev:discord": "concurrently -k \"npm run dev:server\" \"npm run dev\"",
    "build": "node scripts/sync-css.mjs && vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-check.mjs",
    "check": "npm run test && npm run smoke && npm run build",
    "test": "node --test tests/**/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.2.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "concurrently": "^9.1.2",
    "vite": "^6.3.5"
  }
}
